# Podman --env-file for the headlong container.
# Values are literal: do not wrap them in quotes (podman does not strip them).
# Copy to .env, fill in a key, then run:
#   podman run -it --name headlong --restart unless-stopped \
#     -p 8080:8080 --add-host host.docker.internal:host-gateway \
#     --env-file .env headlong

# One LLM provider key (pick one; required for a non-interactive first run)
OPENROUTER_API_KEY=
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#GEMINI_API_KEY=

# Optional: interview answers (skip all for the interactive prompt)
HEADLONG_IDENTITY_NAME=ada
HEADLONG_IDENTITY_VIBE=curious, warm, and plainspoken
HEADLONG_IDENTITY_FOCUS=learning how their own mind works
HEADLONG_OPERATOR_NAME=
HEADLONG_IDENTITY_USER=

# Optional: local OpenAI-compatible model server (no cloud key needed)
#HEADLONG_PROVIDER=local
#HEADLONG_LOCAL_URL=http://host.docker.internal:11434/v1
#HEADLONG_LOCAL_MODEL=